<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DominATE Tour Brasil - Dicas</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <button class="menu-toggle" aria-label="Abrir menu">
                &#9776; <!-- Ícone de hambúrguer -->
            </button>
            <ul class="nav-list">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="https://www.ticketmaster.com.br/event/stray-kids" class="nav-link">Comprar ingresso</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="circle-btn-container">
        <button class="circle-btn" onclick="toggleInfo(1)" id="btn-1">
            <img src="images/bolsa.png" alt="Bolsa" class="btn-image">
            <span class="tooltip">O que levar</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(2)" id="btn-2">
            <img src="images/regras.png" alt="Regras" class="btn-image">
            <span class="tooltip">Regras do show</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(3)" id="btn-3">
            <img src="images/projeto.png" alt="Projeto" class="btn-image">
            <span class="tooltip">Projetos dos Fãs</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(4)" id="btn-4">
            <img src="images/pergunta.png" alt="Pergunta" class="btn-image">
            <span class="tooltip">Dúvidas frequentes</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(5)" id="btn-5">
            <img src="images/ingresso.png" alt="Ingresso" class="btn-image">
            <span class="tooltip">Como comprar ingressos</span>
        </button>
    </div>




    <div class="info-boxes-container">
        <div id="info-box-1" class="info-box">

            <div class="show-prep-container">
                <div class="text-container">
                    <p class="title">O QUE LEVAR</p>
                    <ul class="checklist">
                        <li><label><input type="checkbox" data-item="Ingressos"> Ingressos</label></li>
                        <li><label><input type="checkbox" data-item="Documento de identidade"> Documento de
                                identidade</label></li>
                        <li><label><input type="checkbox" data-item="Dinheiro"> Dinheiro</label></li>
                        <li><label><input type="checkbox" data-item="Cartão de crédito/débito"> Cartão de crédito/débito</label></li>
                        <li><label><input type="checkbox" data-item="Carregador portátil"> Carregador
                                portátil</label></li>
                        <li><label><input type="checkbox" data-item="Lanche"> Lanche</label></li>
                        <li><label><input type="checkbox" data-item="Água"> Água</label></li>
                        <li><label><input type="checkbox" data-item="Capa de Chuva"> Capa de chuva</label></li>
                        <li><label><input type="checkbox" data-item="Protetor solar"> Protetor Solar</label></li>
                        <li><label><input type="checkbox" data-item="Remédios"> Remédios</label></li>
                    </ul>
                </div>
            </div>

        </div>
        <div id="info-box-2" class="info-box">Regras do show</div>
        <div id="info-box-3" class="info-box">Projetos dos Fãs</div>
        <div id="info-box-4" class="info-box">Duvidas frequentes</div>
        <div id="info-box-5" class="info-box">Como comprar ingressos</div>
    </div>

    <footer class="footer">
        <p>
            Criado por <a href="https://www.linkedin.com/in/sara-gongora-a41aa221a" target="_blank">Sara</a> |
            <a href="https://github.com/seu-usuario-github" target="_blank">GitHub</a>
        </p>
    </footer>

    <script src="/js/script.js"></script>
</body>

</html>