<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DominATE Tour Brasil - Dicas</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <button class="menu-toggle" aria-label="Abrir menu">
                &#9776; <!-- Ícone de hambúrguer -->
            </button>
            <ul class="nav-list">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="https://www.ticketmaster.com.br/event/stray-kids" class="nav-link">Comprar ingresso</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="circle-btn-container">
        <button class="circle-btn" onclick="toggleInfo(1)" id="btn-1">
            <img src="images/bolsa.png" alt="Bolsa" class="btn-image">
            <span class="tooltip">O que levar</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(2)" id="btn-2">
            <img src="images/regras.png" alt="Regras" class="btn-image">
            <span class="tooltip">Regras do show</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(3)" id="btn-3">
            <img src="images/projeto.png" alt="Projeto" class="btn-image">
            <span class="tooltip">Projetos dos Fãs</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(4)" id="btn-4">
            <img src="images/pergunta.png" alt="Pergunta" class="btn-image">
            <span class="tooltip">Dúvidas frequentes</span>
        </button>
        <button class="circle-btn" onclick="toggleInfo(5)" id="btn-5">
            <img src="images/ingresso.png" alt="Ingresso" class="btn-image">
            <span class="tooltip">Como comprar ingressos</span>
        </button>
    </div>




    <div class="info-boxes-container">
        <div id="info-box-1" class="info-box">

            <div class="show-prep-container">
                <div class="text-container">
                    <p class="title">O QUE LEVAR</p>
                    <ul class="checklist">
                        <li><label><input type="checkbox" data-item="Ingressos"> Ingressos</label></li>
                        <li><label><input type="checkbox" data-item="Documento de identidade"> Documento de
                                identidade</label></li>
                        <li><label><input type="checkbox" data-item="Dinheiro"> Dinheiro</label></li>
                        <li><label><input type="checkbox" data-item="Cartão de crédito/débito"> Cartão de
                                crédito/débito</label></li>
                        <li><label><input type="checkbox" data-item="Carregador portátil"> Carregador
                                portátil</label></li>
                        <li><label><input type="checkbox" data-item="Lanche"> Lanche</label></li>
                        <li><label><input type="checkbox" data-item="Água"> Água</label></li>
                        <li><label><input type="checkbox" data-item="Capa de Chuva"> Capa de chuva</label></li>
                        <li><label><input type="checkbox" data-item="Protetor solar"> Protetor Solar</label></li>
                        <li><label><input type="checkbox" data-item="Remédios"> Remédios</label></li>
                    </ul>
                </div>
            </div>

        </div>

        <div id="info-box-2" class="info-box">
            <div class="show-prep-container">
                <div class="text-container">
                    <p class="title">O QUE NÃO LEVAR</p>
                    <ul class="forbidden-list">
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Bebidas alcoólicas</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Substâncias ilícitas</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Objetos cortantes</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Garrafas de vidro</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Câmeras profissionais</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span> Fogos
                            de artifício</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Tablets</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Guarda-chuvas</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Bastões de selfie</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Cadeiras dobráveis</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Cigarros eletrônicos</li>
                        <li><span class="icon_proibido"><img src="images/icon_proibido.png" alt="Proibido"></span>
                            Utencílios de armazenagem</li>
                    </ul>
                </div>
            </div>

        </div>

        <div id="info-box-3" class="info-box">
            <p class="title">PROJETOS DOS FÃS</p>



        </div>


        <div id="info-box-4" class="info-box">
            <p class="title">DÚVIDAS FREQUENTES</p>
            <div class="faq-container">
                <div class="faq-item">
                    <button class="faq-question">Qual o tamanho permitido de bolsa?</button>
                    <p class="faq-answer">O tamanho máximo permitido para bolsas é de 30cm x 20cm x 10cm.</p>
                </div>

                <div class="faq-item">
                    <button class="faq-question">Quais alimentos posso levar?</button>
                    <p class="faq-answer">Você pode levar alimentos industrializados lacrados, como biscoitos, barras de
                        cereais e chocolates.</p>
                </div>

                <div class="faq-item">
                    <button class="faq-question">Qual documento levar para meia entrada?</button>
                    <p class="faq-answer">É necessário apresentar um documento oficial com foto e a carteirinha de
                        estudante válida.</p>
                </div>

                <div class="faq-item">
                    <button class="faq-question">Qual o horário de entrada e início do show?</button>
                    <p class="faq-answer">Os portões abrem às 16h e o show começa às 20h.</p>
                </div>

                <div class="faq-item">
                    <button class="faq-question">Como chegar ao local do show?</button>
                    <p class="faq-answer">O local pode ser acessado por transporte público ou aplicativos de transporte.
                        Consulte o site oficial para rotas detalhadas.</p>
                </div>
            </div>
        </div>


        <div id="info-box-5" class="info-box">
            <p class="title">SOBRE INGRESSOS</p>
            <div class="buttons-container">
                <button class="info-btn" data-info="comprar">Onde comprar</button>
                <button class="info-btn" data-info="valores">Valores</button>
                <button class="info-btn" data-info="digital">Ingresso Digital</button>
                <button class="info-btn" data-info="cuidado">Tome cuidado</button>
            </div>
        
            <div class="info-content hidden">
                <button class="back-btn hidden">←</button>
                <p id="info-text"></p>
        
                <!-- Tabela de Valores -->
                <div id="valores-info" class="hidden">
                    <select id="estado-select">
                        <option value="RJ">Rio de Janeiro</option>
                        <option value="SP">São Paulo</option>
                    </select>
        
                    <table id="valores-tabela">
                        <thead>
                            <tr>
                                <th>Setor</th>
                                <th>Inteira</th>
                                <th>Meia entrada</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Os dados serão preenchidos dinamicamente com JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
    </div>


    
    <footer class="footer">
        <p>
            Criado por <a href="https://www.linkedin.com/in/sara-gongora-a41aa221a" target="_blank">Sara</a>
        </p>
    </footer>

    <script src="/js/script.js"></script>
</body>

</html>