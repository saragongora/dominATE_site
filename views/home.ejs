<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Progresso da Contagem</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <ul class="nav-list">
                <li><a href="/" class="nav-link">Home</a></li>
                <li><a href="/o-que-levar" class="nav-link">O que levar</a></li>
                <li><a href="/dicas" class="nav-link">Dicas</a></li>
                <li><a href="https://www.ticketmaster.com.br/event/stray-kids" class="nav-link">Comprar ingresso</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="image-container">
        <img src="images/logo.png" alt="" class="home-image">
    </div>

    <div class="button-group">
        <button class="nav-button active">RJ - 01/04</button>
        <button class="nav-button">SP - 05/04</button>
        <button class="nav-button">SP - 06/04</button>
    </div>

    <!-- Barra de progresso -->
    <div class="progress-container">
        <div id="progress-bar" class="progress-bar"></div>
    </div>

    <!-- Texto que alterna entre as frases -->
    <div id="loading-text" class="loading-text">Carregando...</div>

    <div class="image-div">
        <img src="images/div.png" alt="" class="div-image">
        <span class="overlay-text">FALTAM</span>
        <div class="countdown-container">
            <div class="time-box">
                <span id="days" class="time-value">00</span>
                <span class="time-label">DIAS</span>
            </div>
            <div class="time-box">
                <span id="hours" class="time-value">00</span>
                <span class="time-label">HORAS</span>
            </div>
            <div class="time-box">
                <span id="minutes" class="time-value">00</span>
                <span class="time-label">MINUTOS</span>
            </div>
            <div class="time-box">
                <span id="seconds" class="time-value">00</span>
                <span class="time-label">SEGUNDOS</span>
            </div>

        </div>
        <span class="overlay-text2">PARA O SHOW</span>
    </div>

    <div class="container-maps-playlist">
        <div class="maps">
            <p class="title">LOCAL</p>
            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2608.2967269873852!2d-43.2948930908324!3d-22.89326993729833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x997d070e398159%3A0x9e05df3c77e2e376!2sEst%C3%A1dio%20Ol%C3%ADmpico%20Nilton%20Santos!5e1!3m2!1spt-BR!2sbr!4v1736864702115!5m2!1spt-BR!2sbr"
                width="400" height="300" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
        <div class="playlist">
            <p class="title">SETLIST</p>
            <iframe style="border-radius:12px" src="https://open.spotify.com/embed/playlist/0sy1kwM64rsphg2AS4Pvaw?utm_source=generator" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
    </div>

    <footer class="footer">
        <p>
            Criado por <a href="https://www.linkedin.com/in/sara-gongora-a41aa221a" target="_blank">Sara</a> | 
            <a href="https://github.com/seu-usuario-github" target="_blank">GitHub</a>
        </p>
    </footer>
    

    
    

    <script>
        // Data do evento - 1 de abril de 2025, às 19h (horário de Brasília)
        const targetDate = new Date('2025-04-01T19:00:00-03:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime(); // Data atual
            const timeLeft = targetDate - now; // Diferença em milissegundos

            if (timeLeft > 0) {
                // Calcula dias, horas, minutos e segundos
                const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
                const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                // Atualiza os elementos HTML
                document.getElementById('days').textContent = days.toString().padStart(2, '0');
                document.getElementById('hours').textContent = hours.toString().padStart(2, '0');
                document.getElementById('minutes').textContent = minutes.toString().padStart(2, '0');
                document.getElementById('seconds').textContent = seconds.toString().padStart(2, '0');
            } else {
                // Quando a contagem terminar
                document.querySelector('.countdown-container').innerHTML = '<span style="font-size: 24px; color: white;">O SHOW COMEÇOU!</span>';
            }
        }

        // Atualiza a cada segundo
        setInterval(updateCountdown, 1000);
        updateCountdown(); // Chama imediatamente ao carregar

        // Datas de início e fim
        const startDate = new Date('2024-11-27'); // 27 de novembro de 2024
        const endDate = new Date('2025-04-01'); // 1 de abril de 2025

        // Função para calcular a porcentagem de progresso
        function calculateProgress() {
            const currentDate = new Date(); // Data atual
            const totalDuration = endDate - startDate; // Duração total em milissegundos
            const elapsedTime = currentDate - startDate; // Tempo já passado em milissegundos

            // Calculando a porcentagem de progresso
            let progress = (elapsedTime / totalDuration) * 100;
            if (progress > 100) {
                progress = 100; // Limitar em 100%
            }
            return progress;
        }

        // Atualizar a barra de progresso
        function updateProgressBar() {
            const progress = calculateProgress();
            const progressBar = document.getElementById('progress-bar');
            progressBar.style.width = progress + '%';
        }

        // Atualizar a barra de progresso a cada 1 segundo
        setInterval(updateProgressBar, 1000);
        // Chamar uma vez ao carregar a página
        updateProgressBar();

        // Frases que alternam no texto de carregamento
        const phrases = ['...Carregando', 'Stray Kids está chegando...'];
        let currentPhraseIndex = 0;

        // Função para alternar o texto de carregamento
        function toggleLoadingText() {
            const loadingText = document.getElementById('loading-text');
            currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length; // Alterna entre 0 e 1
            loadingText.textContent = phrases[currentPhraseIndex];
        }

        // Alternar o texto a cada 2.5 segundo
        setInterval(toggleLoadingText, 2500);
    </script>
</body>

</html>