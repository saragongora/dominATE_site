<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DominATE Tour Brasil</title>
    <meta name="description" content="Tudo sobre o DominATE Tour Brasil - dicas, ingressos, local e setlist!">
    <meta name="keywords" content="DominATE Tour, Stray Kids, ingressos, show, Brasil">
    <meta name="author" content="Sara Gongora">
    <meta property="og:title" content="DominATE Tour Brasil">
    <meta property="og:description" content="Dicas e informações sobre o show do Stray Kids no Brasil.">
    <meta property="og:image" content="images/logo.png">
    <meta property="og:type" content="website">
    <meta name="robots" content="index, follow">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet"
        crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="navbar">
        <div class="nav-container">
            <button class="menu-toggle" aria-label="Abrir menu" aria-expanded="false">
                &#9776;
            </button>
            <ul class="nav-list">
                <li><a href="/dicas" class="nav-link">Dicas para o Show</a></li>
                <li><a href="https://www.ticketmaster.com.br/event/stray-kids" class="nav-link">Comprar ingresso</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="image-container">
        <img src="images/logo.png" alt="Logo da DominATE Tour" class="home-image">
    </div>

    <div class="button-group">
        <button class="nav-button active">RJ - 01/04</button>
        <button class="nav-button">SP - 05/04</button>
        <button class="nav-button">SP - 06/04</button>
    </div>

    <!-- Barra de progresso -->
    <div class="progress-container">
        <div id="progress-bar" class="progress-bar"></div>
    </div>

    <!-- Texto que alterna entre as frases -->
    <div id="loading-text" class="loading-text">Carregando...</div>

    <div class="image-div">
        <img src="images/div.svg" alt="Imagem de fundo vermelha" class="div-image">
        <!-- Container do contador -->
        <div class="countdown-wrapper">
            <p class="overlay-text">FALTAM</p>
            <div class="countdown-container">
                <iframe id="countdown-frame" class="countdown-frame" src="" loading="lazy" scrolling="no"
                    aria-hidden="true"></iframe>
            </div>
            <p class="overlay-text2">PARA O SHOW</p>
        </div>
    </div>

    <div class="container-maps-playlist">
        <div class="maps">
            <p class="title">LOCAL</p>
            <iframe id="map-iframe"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2608.2967269873852!2d-43.2948930908324!3d-22.89326993729833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x997d070e398159%3A0x9e05df3c77e2e376!2sEst%C3%A1dio%20Ol%C3%ADmpico%20Nilton%20Santos!5e1!3m2!1spt-BR!2sbr!4v1736864702115!5m2!1spt-BR!2sbr"
                width="400" height="300" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                aria-hidden="true">
            </iframe>
        </div>
        <div class="playlist">
            <p class="title">SETLIST</p>
            <iframe style="border-radius:12px"
                src="https://open.spotify.com/embed/playlist/0sy1kwM64rsphg2AS4Pvaw?utm_source=generator" width="100%"
                height="352" frameBorder="0" allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"
                aria-hidden="true"></iframe>
        </div>
    </div>

    <footer class="footer">
        <p>
            Criado por <a href="https://www.linkedin.com/in/sara-gongora-a41aa221a" target="_blank"
                rel="noopener noreferrer">Sara</a> |
            <a href="https://onlinealarmkur.com/countdown/pt/" target="_blank" class="creditos">Countdown</a>
        </p>
    </footer>

    <script src="/js/script.js" defer></script>

</body>
</html>